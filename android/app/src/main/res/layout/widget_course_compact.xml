<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:paddingStart="11dp"
    android:paddingTop="10dp"
    android:paddingEnd="11dp"
    android:paddingBottom="10dp">

    <!-- 顶栏：星期 + 今日总节数 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_compact_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="周三"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_compact_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:text="共4节课"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 空状态提示 -->
    <TextView
        android:id="@+id/tv_compact_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="今日无课"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <!-- 主内容区：第 1 节展开 + 第 2 节紧凑 -->
    <LinearLayout
        android:id="@+id/layout_compact_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 主展开卡（当前/下一节） -->
        <FrameLayout
            android:id="@+id/compact_slot_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/compact_bg_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_item_bg"
                android:tint="@color/widget_preview_item_blue" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="6dp"
                android:paddingEnd="7dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/compact_bar_0"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_item_bar"
                    android:tint="#42A5F5" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/compact_title_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="大学物理"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/compact_time_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="08:00 - 09:40"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/compact_loc_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="电教202"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- 紧凑次卡（紧接着的下节课） -->
        <FrameLayout
            android:id="@+id/compact_slot_1"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/compact_bg_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_item_bg"
                android:tint="@color/widget_preview_item_teal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingEnd="7dp">

                <ImageView
                    android:id="@+id/compact_bar_1"
                    android:layout_width="3dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_item_bar"
                    android:tint="#26A69A" />

                <TextView
                    android:id="@+id/compact_title_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="军事理论"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
